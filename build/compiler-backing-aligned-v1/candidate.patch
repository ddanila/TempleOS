+#include "/Kernel/I386/HeapAllocateBlock.HC"
+U8 *I386MemBackingAllocAlignedHigh(CI386Heap *heap,U32 size)
+{//The entire arena is validated by the grow caller with IRQs masked.
+  CI386HeapBlock *block,*selected=0;
+  U32 offset=0,tail,need,selected_need=0;
+  while(offset<heap->size) {
+    block=heap->base+offset;
+    tail=((block(U8 *)+block->span)(U32))&511;
+    need=tail+size+((sizeof(CI386BackingRegion)+7)&~7)+16;
+    if(block->tag==I386_HEAP_FREE && block->span>=need) {
+      selected=block;
+      selected_need=need;
+    }
+    offset+=block->span;
+  }
+  if(!selected)return 0;
+  return I386HeapAllocateBlock(heap,selected,selected_need-16,selected_need,FALSE,TRUE);
+}
 Bool I386MemBackingGrow(CI386PublicPool *base_pool,I64 pages)
 {//Called once per exhausted page request, IRQs masked, pool unlocked.
