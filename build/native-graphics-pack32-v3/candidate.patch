+    AND EAX,0x01010101
+    MOV EDX,0x01020408
+    IMUL2 EAX,EDX
+    SHR EAX,24
+    MOV ECX,U32 &current_high[EBP]
+    AND ECX,0x01010101
+    IMUL2 ECX,EDX
+    SHR ECX,20
+    AND ECX,0xF0
+    OR EAX,ECX
+    MOV ECX,U32 &plane[EBP]
+    MOV ECX,U32 [EDI+ECX*4]
+    ADD ECX,U32 &index[EBP]
