+Bool I386PowerPublish(U64 (*implementation)(U64 base,U64 exponent))
+{
+  CI386Task *task=I386TaskSelf;
+  if (!implementation || task!=task->owner->root) return FALSE;
+  if (i386_power_implementation && i386_power_implementation!=implementation) return FALSE;
+  i386_power_implementation=implementation;
+  return TRUE;
+}
+
+I64 I386PowerLoad()
+{//Runs on Adam so the readiness check and publication share the owner.
+  CI386KernelSymbol *loader;
+  I64 (*load_file)(U8 *filename,Bool warn_extension);
+  if (!i386_power_implementation) {
+    loader=HashFind("_ADAM_FILE",I386TaskSelf->hash_table,HTT_EXPORT_SYS_SYM);
+    if (!loader || loader->kind!=1 || !loader->val) return 0;
+    load_file=loader->val;
+    (*load_file)("::/Kernel/I386/FloatPower.HC",FALSE);
+  }
+  if (i386_power_implementation) return 1;
+  return 0;
+}
+
+U64 I386F64Power(U64 base,U64 exponent)
+{
+  CI386Task *task;
+  CI386KernelSymbol *loader;
+  I64 (*adam)(U8 *format,...);
+  if (!i386_power_implementation) {
+    task=I386TaskSelf;
+    if (task==task->owner->root)
+      I386PowerLoad;
+    else {
+      loader=HashFind("_ADAM",task->hash_table,HTT_EXPORT_SYS_SYM);
+      if (loader && loader->kind==1 && loader->val) {
+        adam=loader->val;
+        (*adam)("Call(0x%X);",&I386PowerLoad);
+      }
+    }
+    if (!i386_power_implementation) throw('PowLoad',TRUE);
+  }
+  return (*i386_power_implementation)(base,exponent);
+}
