U64 wide_operands[32]={
  0x402C48C6001F0AC0,0xBFE6A09E667F3BCC,
  0x402C48C6001F0AC0,0x3FE6A09E667F3BCC,
  0x8000000000000000,0x3FF0000000000000,
  0x0000000000000001,0x7FEFFFFFFFFFFFFF,
  0x000FFFFFFFFFFFFF,0x7FEFFFFFFFFFFFFF,
  0x800FFFFFFFFFFFFF,0x7FEFFFFFFFFFFFFF,
  0x3FEFFFFFFFFFFFFF,0x3FF0000000000000,
  0x3FF0000000000000,0x3FF0000000000000,
  0x3FF0000000000001,0x3FF0000000000000,
  0x43DFFFFFFFFFFFFF,0x3FF0000000000000,
  0x43E0000000000000,0x3FF0000000000000,
  0xC3E0000000000000,0x3FF0000000000000,
  0x7FF8000000000001,0x3FF0000000000000,
  0x7FF0000000000000,0,
  0xFFEFFFFFFFFFFFFF,0x7FEFFFFFFFFFFFFF,
  0x000FFFFFFFFFFFFF,0x0010000000000000
};
I64 wide_results[16];

I64 WideCheckOriginal(F64 a,F64 b)
{
  return a*b;
}

U0 WideCheck()
{
  I64 i;
  U8 msg[128],*p;
  for (i=0;i<16;i++)
    wide_results[i]=WideCheckOriginal(wide_operands[i*2](F64),wide_operands[i*2+1](F64));
  StrPrint(msg,"EXPORT BallVertexMath.bin %X 80\n",wide_results);
  for (p=msg;*p;p++) OutU8(0xE9,*p);
  Sleep(2000);
  for (p="BALL math ready\n";*p;p++) OutU8(0xE9,*p);
}
WideCheck;
