diff --git a/Kernel/I386/Memory.HC b/Kernel/I386/Memory.HC
index e37c8fbf..dc8fdf64 100644
--- a/Kernel/I386/Memory.HC
+++ b/Kernel/I386/Memory.HC
@@ -97,11 +97,15 @@ Bool I386MemPoolValid(CI386PublicPool *pool)
 CI386PoolRegion *I386MemBlockRegion(CI386PublicPool *pool,CMemBlk *block)
 {//Pool shape already validated; test address membership before reading the block.
   CI386PoolRegion *region;
-  U64 address=(block+0)(U64),base;
-  if(!block || address&511) return 0;
+  U64 wide_address=(block+0)(U64);
+  U32 address,base;
+  if(!block || wide_address>0xFFFFFFFF || wide_address&511) return 0;
+  address=wide_address;
   for(region=pool->regions;region;region=region->next) {
-    base=(region->base+0)(U64);
-    if(base<=address && address<=base+region->size-512) return region;
+    base=(region->base+0)(U32);
+    //Valid regions fit below 4 GiB. Subtraction also covers a region
+    //that ends exactly at the boundary without wrapping its upper limit.
+    if(address>=base && (address-base)(U32)<=(region->size-512)(U32)) return region;
   }
   return 0;
 }
