+
+U0 NativeWindowUpdateODEs();
+U0 NativeWindowUpdateODEs()
+{//Snapshot eligible task identities before calling any derivative.
+  CNativeWindowListScope scope;
+  CTask *task,*anchor=sys_winmgr_task;
+  I64 *numbers=NULL,count=0,i=0;
+  scope.numbers=&numbers;
+  try {
+    NativeRenderScopeOpen(&scope,&NativeWindowListRelease);
+    task=anchor;
+    do {
+      if(!TaskValidate(task))throw('WinList',TRUE);
+      if(task->next_ode && task->next_ode!=&task->next_ode)count++;
+      task=task->next_task;
+    } while(task!=anchor);
+    if(count) {
+      numbers=MAlloc(count*sizeof(I64));
+      task=anchor;
+      do {
+        if(task->next_ode && task->next_ode!=&task->next_ode)
+          numbers[i++]=task->task_num;
+        task=task->next_task;
+      } while(task!=anchor);
+      winmgr.ode_time=0;
+      for(i=0;i<count;i++) {
+        task=NativeWindowFind(numbers[i]);
+        if(task && !NativeRenderOwnerClosing(task))NativeWindowUpdateOneODE(task);
+      }
+      winmgr.last_ode_time=winmgr.ode_time;
+    }
+    NativeWindowListRelease(&scope);
+  } catch {
+    NativeWindowListRelease(&scope);
+    NativeRenderScopeClose(&scope);
+  }
+  NativeRenderScopeClose(&scope);
+}
