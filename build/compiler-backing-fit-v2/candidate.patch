+#include "/Kernel/I386/HeapAllocateBlock.HC"
+U8 *I386MemBackingAllocSmall(CI386Heap *heap,U32 request)
+{//Growth already validated both arenas and excludes competing heap mutations.
+  CI386HeapBlock *block,*best=0;
+  U32 offset=0,need=((request+7)&~7)+16;
+  while(offset<heap->size) {
+    block=heap->base+offset;
+    if(block->tag==I386_HEAP_FREE && block->span>=need &&
+        (!best || block->span<=best->span))best=block;
+    offset+=block->span;
+  }
+  if(!best)return 0;
+  return I386HeapAllocateBlock(heap,best,request,need,FALSE,TRUE);
+}
 Bool I386MemBackingGrow(CI386PublicPool *base_pool,I64 pages)
