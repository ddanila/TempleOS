//Original x87 Ona2Freq bits: octave bases and signed nibble corrections.
U64 native_ona_frequency_bases[12]={
  0x403B800000000000,0x403D229EC465C8A0,0x403EDE22007F791A,0x40405A0250C2B956,
  0x404152EC0E758E6F,0x40425AA2E3AF0B21,0x4043720820155763,0x40449A0A791E127A,
  0x4045D3A6D600CABC,0x40471FE927CA0DE9,0x40487FED4E47ADFE,0x4049F4E00A91D08E,
};
U8 native_ona_frequency_corrections[128]={
  0x88,0x86,0x88,0x98,0x88,0x89,0x88,0x88,0x88,0x88,0x88,0x88,0xA8,0x86,0x78,0x98,
  0x87,0x7A,0xA8,0x86,0x78,0x98,0x87,0x7A,0x78,0x88,0x97,0x88,0x88,0x98,0x78,0x88,
  0x97,0x88,0x88,0x98,0x78,0x88,0x97,0x88,0x88,0x98,0x78,0x88,0x97,0x88,0x88,0x98,
  0xC8,0x83,0x5A,0xB8,0x85,0x5C,0xC8,0x83,0x5A,0xB8,0x85,0x5C,0xC8,0x83,0x5A,0xB8,
  0x5A,0xB8,0x85,0x5C,0xC8,0x83,0x5A,0xB8,0x85,0x5C,0xC8,0x83,0x5A,0xB8,0x85,0x5C,
  0x78,0x88,0x97,0x88,0x88,0x98,0x78,0x88,0x97,0x88,0x88,0x98,0x78,0x88,0x97,0x88,
  0x88,0x98,0x78,0x88,0x97,0x88,0x88,0x98,0xA8,0x86,0x78,0x98,0x87,0x7A,0xA8,0x86,
  0x78,0x98,0x87,0x7A,0x88,0x88,0x88,0x88,0x88,0x88,0x88,0x86,0x78,0x88,0x88,0x89,
};
public F64 Ona2Freq(I8 ona)
{
  I64 note=ona,index=note&255,remainder,octave,correction;
  if(!note) return 0.0;
  remainder=(note+132)%12;octave=(note-12-remainder)/12;
  correction=native_ona_frequency_corrections[index>>1];
  if(index&1)correction>>=4;
  correction=(correction&15)-8;
  return (native_ona_frequency_bases[remainder]+(octave<<52)+correction)(F64);
}
