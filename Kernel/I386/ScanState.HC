#include "/Kernel/I386/ScanState.HH"
public U8 I386ScanMap(U8 code,Bool num=FALSE)
{//Literal copies of the two maps in Kernel/SerialDev/Keyboard.HC.
  U8 *table;
  if (num) table=
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x08\x09\x0A\x00\x05\x06\x07\x00\x02"
    "\x03\x04\x0B\x34\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1C\x1D\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x35\x00\x00\x38\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x47\x48\x49\x00\x4B\x00\x4D\x00\x4F"
    "\x50\x51\x52\x53\x00\x00\x00\x00\x00\x00\x00\x00\xDB\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00";
  else table=
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x2A\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1C\x1D\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x35\x00\x00\x38\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x47\x48\x49\x00\x4B\x00\x4D\x00\x4F"
    "\x50\x51\x52\x53\x00\x00\x00\x00\x00\x00\x00\x00\xDB\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
    "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00";
  if (table[code]) return table[code];
  return code;
}
public U0 I386ScanStateReset(CI386ScanState *state)
{
  I64 i;
  if (!state) return;
  state->locks=0;
  for (i=0;i<256;i++) { state->down[i]=0; state->mapped[i]=0; }
}
public Bool I386ScanStateApply(CI386ScanState *state,U32 raw,I64 *event)
{//Single consumer; outputs outside the state. Lock keys toggle on matched release.
  U32 code=raw&255,mapped,flags,old_mods=0;
  Bool up=FALSE,was_down;
  I64 low,high;
  if (!state || !event || raw>0x1FF || !code) return FALSE;
  if (raw&0x100) up=TRUE;
  if (state->down[0x2A] || state->down[0x36]) old_mods|=0x200;
  if (state->down[0x1D] || state->down[0x9D]) old_mods|=0x400;
  if (state->down[0x38] || state->down[0xB8]) old_mods|=0x800;
  was_down=state->down[code];
  mapped=I386ScanMap(code,(state->locks&0x2000)!=0);
  if (was_down) mapped=state->mapped[code];
  if (up) {
    state->down[code]=0;
    if (was_down) {
      if (code==0x3A) state->locks^=0x1000;
      if (code==0x45) state->locks^=0x2000;
      if (code==0x46) state->locks^=0x4000;
    }
  } else if (code!=0x61) {
    state->down[code]=1; state->mapped[code]=mapped;
  }
  flags=state->locks|0x8000;
  if (state->down[0x2A] || state->down[0x36]) flags|=0x200;
  if (state->down[0x1D] || state->down[0x9D]) flags|=0x400;
  if (state->down[0x38] || state->down[0xB8]) flags|=0x800;
  if ((state->down[0x53] && state->mapped[0x53]==0x53) || state->down[0xD3]) flags|=0x40000;
  if ((state->down[0x52] && state->mapped[0x52]==0x52) || state->down[0xD2]) flags|=0x80000;
  if (!up && (((code==0x2A || code==0x36) && (old_mods&0x200)) ||
      ((code==0x1D || code==0x9D) && (old_mods&0x400)) ||
      ((code==0x38 || code==0xB8) && (old_mods&0x800)))) flags&=~0x8000;
  low=flags|mapped|(raw&0x100); high=flags|raw;
  *event=low|(high<<32);
  return TRUE;
}
