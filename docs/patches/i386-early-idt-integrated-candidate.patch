diff --git a/Kernel/I386/PublicResident.HC b/Kernel/I386/PublicResident.HC
new file mode 100644
index 00000000..8d694170
--- /dev/null
+++ b/Kernel/I386/PublicResident.HC
@@ -0,0 +1,52 @@
+Bool NativeResidentZ(U8 *name)
+{ I64 n=StrLen(name);return n>=2 && name[n-2]=='.' && name[n-1]=='Z'; }
+U8 *NativeResidentAlt(U8 *name)
+{
+  I64 n=StrLen(name),size=n+3;U8 *alt=I386HeapAlloc(console_config->heap,size,TRUE);
+  if(!alt)return 0;MemCpy(alt,name,n);
+  if(NativeResidentZ(name))alt[n-2]=0;else {alt[n]='.';alt[n+1]='Z';}
+  return alt;
+}
+CHashGeneric *NativeResidentLookup(U8 *name)
+{ return HashFind(name,Fs->gs->seth_task->hash_table,HTT_FILE); }
+U0 NativeResidentRemove(CHashGeneric *entry)
+{
+  CHashTable *table=Fs->gs->seth_task->hash_table;CHash **link;I64 i;
+  while(table) {
+    for(i=0;i<=table->mask;i++) {
+      link=table->body+i;
+      while(*link) {
+        if(*link==entry) {*link=entry->next;Free(entry->str);Free(entry->user_data0);Free(entry);return;}
+        link=&(*link)->next;
+      }
+    }
+    table=table->next;
+  }
+}
+U0 NativeResidentPut(U8 *name,U8 *stored,I64 bytes)
+{
+  CTask *owner=Fs->gs->seth_task;CHashGeneric *entry=NativeResidentLookup(name),*created=0;
+  U8 *data=0,*copy=0;I64 n=StrLen(name);
+  try {
+    data=MAlloc(bytes+1,owner);MemCpy(data,stored,bytes);data[bytes]=0;
+    if(!entry) {
+      created=CAlloc(sizeof(CHashGeneric),owner);copy=MAlloc(n+1,owner);MemCpy(copy,name,n+1);
+      created->str=copy;created->type=HTT_FILE;entry=created;
+    }
+  } catch {Free(data);Free(copy);Free(created);Fs->catch_except=FALSE;}
+  if(!created)Free(entry->user_data0);
+  entry->user_data0=data;entry->user_data1=bytes;
+  if(created)HashAdd(entry,owner->hash_table);
+}
+U8 *NativeResidentCopy(U8 *raw,I64 bytes,I64 attr,I64 *size)
+{
+  U8 *expanded=0,*result;I64 count=bytes;
+  if(attr&0x400) {
+    expanded=console_config->files->expand(console_config->heap,raw,bytes,&count);
+    if(!expanded)return 0;raw=expanded;
+  }
+  try {result=MAlloc(count+1);MemCpy(result,raw,count);result[count]=0;}
+  catch {if(expanded)I386HeapFree(console_config->heap,expanded);Fs->catch_except=FALSE;}
+  if(expanded)I386HeapFree(console_config->heap,expanded);
+  *size=count;return result;
+}
diff --git a/Kernel/I386/ResidentFiles.HC b/Kernel/I386/ResidentFiles.HC
new file mode 100644
index 00000000..52bd9cca
--- /dev/null
+++ b/Kernel/I386/ResidentFiles.HC
@@ -0,0 +1,48 @@
+//Mounted-service cache. Callers hold IF clear; entries own stored bytes.
+CI386ResidentFile *I386ResidentFind(CI386FileVolumes *volumes,U8 *name)
+{
+  CI386ResidentFile *entry=volumes->resident;
+  I64 i;
+  while(entry) {
+    i=0; while(name[i] && name[i]==entry->name[i]) i++;
+    if(name[i]==entry->name[i]) return entry;
+    entry=entry->next;
+  }
+  return 0;
+}
+Bool I386ResidentStore(CI386FileVolumes *volumes,CI386Heap *heap,U8 *name,U8 *data,I64 size,Bool resident)
+{
+  CI386ResidentFile *entry=0,*old,*previous=0,*cursor;
+  I64 length=0,i;
+  if(resident) {
+    heap=volumes->resident_heap; if(!heap) return FALSE;
+    while(name[length]) length++;
+    if(size<0 || size>0x7FFFFFFF-length-sizeof(CI386ResidentFile)-2) return FALSE;
+    entry=I386HeapAlloc(heap,sizeof(CI386ResidentFile)+length+size+2,TRUE);
+    if(!entry) return FALSE;
+    entry->heap=heap; entry->size=size; entry->name=(entry+1)(U8 *);
+    entry->data=entry->name+length+1;
+    for(i=0;i<=length;i++) entry->name[i]=name[i];
+    for(i=0;i<size;i++) entry->data[i]=data[i];
+  }
+  old=I386ResidentFind(volumes,name); cursor=volumes->resident;
+  while(cursor && cursor!=old) {previous=cursor;cursor=cursor->next;}
+  if(old) {
+    if(previous) previous->next=old->next; else volumes->resident=old->next;
+    I386HeapFree(old->heap,old);
+  }
+  if(entry) {entry->next=volumes->resident;volumes->resident=entry;}
+  return TRUE;
+}
+U8 *I386ResidentRead(CI386ResidentFile *entry,CI386Heap *heap,I64 *size,I64 *attr,Bool raw)
+{
+  U8 *result;
+  I64 i,bytes=entry->size,attributes=FileAttr(entry->name,0);
+  if(!raw && attributes&0x400) result=I386ExpandBuf(heap,entry->data,bytes,&bytes);
+  else {
+    result=I386HeapAlloc(heap,bytes+1,TRUE);
+    if(result) for(i=0;i<bytes;i++) result[i]=entry->data[i];
+  }
+  if(result) {if(size)*size=bytes;if(attr)*attr=attributes;}
+  return result;
+}
diff --git a/Kernel/I386/TaskCd.HC b/Kernel/I386/TaskCd.HC
new file mode 100644
index 00000000..33c03117
--- /dev/null
+++ b/Kernel/I386/TaskCd.HC
@@ -0,0 +1,86 @@
+Bool I386TaskCdExists(CI386RedSea *volume,U8 *absolute)
+{
+  CI386RedSeaEntry entry;
+  Bool result=FALSE;
+  if(!volume || !volume->io || !I386RedSeaBegin(volume)) return FALSE;
+  if(I386RedSeaResolve(volume,volume->root,absolute+2,&entry)==1 && entry.attr&0x10) result=TRUE;
+  if(!I386RedSeaEnd(volume)) result=FALSE;
+  return result;
+}
+Bool I386TaskCd(U8 *dirname,Bool make_dirs)
+{
+  U32 flags=I386IrqSave;
+  CI386Task *task=I386TaskSelf;
+  CI386TaskFiles *state;
+  CI386Heap *heap;
+  CFilePathContext paths;
+  CI386FileVolumes *volumes;
+  CI386RedSea *volume;
+  U8 *buffer=0,*mapped=0,*cursor,*component,*clean=0;
+  I64 capacity=8,length=3,i,count,old,drive,ch;
+  Bool result=FALSE,root=FALSE;
+  if(dirname && !*dirname) {I386IrqRestore(flags);return TRUE;}
+  state=I386TaskFilesBorrow(task,&paths,&volumes);
+  if(!state) goto task_cd_done;
+  heap=state->heap;
+  if(!dirname) dirname=paths.home_dir;
+  if(!dirname) goto task_cd_release;
+  for(i=0;dirname[i];i++) capacity++;
+  for(i=0;paths.cur_dir[i];i++) capacity++;
+  for(i=0;paths.home_dir && paths.home_dir[i];i++)capacity++;
+  if(capacity>0x7FFFFFFF) goto task_cd_release;
+  buffer=I386HeapAlloc(heap,capacity,TRUE);
+  mapped=I386FileNameAbs(heap,&paths,dirname);
+  if(!buffer || !mapped) goto task_cd_release;
+  drive=mapped[0]; volume=volumes->letter[drive-'A'];
+  if(!volume || !volume->io) goto task_cd_release;
+  cursor=dirname;
+  if(cursor[0] && cursor[1]==':') {cursor+=2; if(drive!=paths.cur_drv) root=TRUE;}
+  if(*cursor=='/' || !*cursor) {root=TRUE;if(*cursor=='/')cursor++;}
+  buffer[0]=drive;buffer[1]=':';buffer[2]='/';
+  if(!root) {for(i=1;paths.cur_dir[i];i++)buffer[length++]=paths.cur_dir[i];}
+  buffer[length]=0;
+  clean=I386HeapAlloc(heap,capacity,TRUE);if(!clean)goto task_cd_release;
+  while(*cursor && (paths.white_space[*cursor>>5]>>(*cursor&31))&1)cursor++;
+  count=0;while(ch=*cursor++) {
+    if((paths.white_space[ch>>5]>>(ch&31))&1 || ch>=31)clean[count++]=ch;
+  }
+  while(count && (paths.white_space[clean[count-1]>>5]>>(clean[count-1]&31))&1)count--;
+  clean[count]=0;cursor=clean;result=TRUE;
+  while(*cursor && result) {
+    component=cursor;count=0;while(*cursor && *cursor!='/'){cursor++;count++;}
+    if(*cursor=='/')cursor++;
+    if(!count) {length=3;buffer[length]=0;}
+    else if(count==1 && component[0]=='~') {
+      if(!paths.home_dir) {result=FALSE;break;}
+      length=0;while(paths.home_dir[length]) {buffer[length]=paths.home_dir[length];length++;}
+      buffer[length]=0;drive=buffer[0];volume=volumes->letter[drive-'A'];
+      if(!volume || !I386TaskCdExists(volume,buffer))result=FALSE;
+    }
+    else if(count==1 && component[0]=='.') {}
+    else if(count==2 && component[0]=='.' && component[1]=='.') {
+      while(length>3 && buffer[length-1]!='/')length--;
+      if(length>3)length--;buffer[length]=0;
+    } else {
+      old=length;if(length>3)buffer[length++]='/';
+      for(i=0;i<count;i++)buffer[length++]=component[i];buffer[length]=0;
+      if(!I386TaskCdExists(volume,buffer)) {
+        if(!make_dirs || !I386TaskDirMk(buffer,0) || !I386TaskCdExists(volume,buffer)) {
+          length=old;buffer[length]=0;result=FALSE;
+        }
+      }
+    }
+  }
+  if(!I386TaskFilesRelease(state)) {state=0;result=FALSE;goto task_cd_free;}
+  state=0;
+  if(!I386TaskFilesSet(task,buffer+2,drive))result=FALSE;
+  goto task_cd_free;
+task_cd_release:
+  I386TaskFilesRelease(state);
+task_cd_free:
+  if(clean)I386HeapFree(heap,clean);
+  if(mapped)I386HeapFree(heap,mapped);
+  if(buffer)I386HeapFree(heap,buffer);
+task_cd_done:
+  I386IrqRestore(flags);return result;
+}
