+I64 NativeTerminalExecute(CCmpCtrl *cc)
+{
+  CHashFun *entry;
+  I64 (*invoke)(CCmpCtrl *cc);
+  if(!cc || !cc->lex_include_stk)throw('Compiler',TRUE);
+  NativePrsSupportLoad;
+  entry=HashFind("ExeCmdLine",native_jit_support.symbols,HTT_FUN);
+  if(!entry || !entry->exe_addr)throw('CmdLine',TRUE);
+  invoke=entry->exe_addr;return (*invoke)(cc);
+}
