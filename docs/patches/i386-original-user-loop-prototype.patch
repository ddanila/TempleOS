+extern I64 NativeTerminalExecute(CCmpCtrl *cc);
+U0 NativeOriginalTerminalInput()
+{//Terminal key-input-execute loop.
+  CCmpCtrl *cc;
+  CDoc *doc;
+  Bool cont=TRUE;
+  do {
+    cc=CmpCtrlNew(,CCF_CMD_LINE|CCF_PMT|CCF_QUESTION_HELP);
+    QueIns(cc,Fs->last_cc);
+    try {
+      Lex(cc);
+      NativeTerminalExecute(cc);
+      cont=Bt(&cc->flags,CCf_PMT);
+      QueRem(cc);
+      CmpCtrlDel(cc);
+    } catch {
+      if ((doc=Fs->put_doc) && doc->doc_signature==DOC_SIGNATURE_VAL)
+	DocUnlock(doc);
+      PutExcept;
+    }
+  } while (cont);
+}
