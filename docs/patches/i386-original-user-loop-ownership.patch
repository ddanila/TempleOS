+  U32 irq=I386IrqSave;
+  if(task->next_child_task!=children){I386IrqRestore(irq);return;}
+  for(record=native_public_controls;record;record=record->next)
+    if(record->task==task)public_count++;
+  if(!public_count){I386IrqRestore(irq);return;}
+  if(task!=I386TaskSelf || task->compiler_busy)goto public_control_retire_failed;
+  //Bounded preflight: preserve every owned record if links or native cleanup fail.
+  for(cc=task->next_cc;cc!=head;cc=cc->next) {
+    if(++queue_count>public_count+task->active_controls || !cc ||
+        !cc->next || !cc->last || cc->next->last!=cc || cc->last->next!=cc)
+      goto public_control_retire_failed;
+    if(!NativePublicControlFind(cc,task))foreign_count++;
+  }
+  if(foreign_count!=task->active_controls)goto public_control_retire_failed;
+  //A linked public object must belong to this exact task queue. Do not
+  //detach controls borrowed by another task or linked into an unrelated list.
+  for(record=native_public_controls;record;record=record->next)
+    if(record->task==task) {
