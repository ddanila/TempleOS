+//Public controls retain their original allocation size and allocator domain.
+class CNativePublicControlOwner {
+  CNativePublicControlOwner *next;
+  CCmpCtrl *control;
+  CI386Task *task;
+};
+CNativePublicControlOwner *native_public_controls;
+U0 NativePublicControlRegister(CCmpCtrl *cc)
+{
+  CNativePublicControlOwner *record=CAlloc(sizeof(CNativePublicControlOwner));
+  U32 irq=I386IrqSave;
+  record->control=cc;record->task=I386TaskSelf;
+  record->next=native_public_controls;native_public_controls=record;
+  I386IrqRestore(irq);
+}
+U0 NativePublicControlForget(CCmpCtrl *cc)
+{//Called after the ordinary release, without dereferencing the freed control.
+  CNativePublicControlOwner *record,*previous=NULL;
+  U32 irq=I386IrqSave;
+  record=native_public_controls;
+  while(record && record->control!=cc){previous=record;record=record->next;}
+  if(!record)KernelStop;
+  if(previous)previous->next=record->next;else native_public_controls=record->next;
+  I386IrqRestore(irq);Free(record);
+}
+CNativePublicControlOwner *NativePublicControlFind(CCmpCtrl *cc,CI386Task *task)
+{
+  CNativePublicControlOwner *record=native_public_controls;
+  while(record && (record->control!=cc || record->task!=task))record=record->next;
+  return record;
+}
+U0 NativePublicControlOwnerRetire(CI386Task *task)
+{//Committed Exit only, after descendants and render borrowers have retired.
+  CNativePublicControlOwner *record;
+  CCmpCtrl *cc,*scan,*head=&task->next_cc;
+  Bool found;
+  CTask *children=(&task->next_child_task)(U8 *)-offset(CTask.next_sibling_task);
