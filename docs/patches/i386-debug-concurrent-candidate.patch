+Bool NativeResidentZ(U8 *name)
+{ I64 n=StrLen(name);return n>=2 && name[n-2]=='.' && name[n-1]=='Z'; }
+U8 *NativeResidentAlt(U8 *name)
+{
+  I64 n=StrLen(name),size=n+3;U8 *alt=I386HeapAlloc(console_config->heap,size,TRUE);
+  if(!alt)return 0;MemCpy(alt,name,n);
+  if(NativeResidentZ(name))alt[n-2]=0;else {alt[n]='.';alt[n+1]='Z';}
+  return alt;
+}
+CHashGeneric *NativeResidentLookup(U8 *name)
+{ return HashFind(name,Fs->gs->seth_task->hash_table,HTT_FILE); }
+U0 NativeResidentRemove(CHashGeneric *entry)
+{
+  CHashTable *table=Fs->gs->seth_task->hash_table;CHash **link;I64 i;
+  while(table) {
+    for(i=0;i<=table->mask;i++) {
+      link=table->body+i;
+      while(*link) {
+        if(*link==entry) {*link=entry->next;Free(entry->str);Free(entry->user_data0);Free(entry);return;}
+        link=&(*link)->next;
+      }
+    }
+    table=table->next;
+  }
+}
+U0 NativeResidentPut(U8 *name,U8 *stored,I64 bytes)
+{
+  CTask *owner=Fs->gs->seth_task;CHashGeneric *entry=NativeResidentLookup(name),*created=0;
+  U8 *data=0,*copy=0;I64 n=StrLen(name);
+  try {
+    data=MAlloc(bytes+1,owner);MemCpy(data,stored,bytes);data[bytes]=0;
+    if(!entry) {
+      created=CAlloc(sizeof(CHashGeneric),owner);copy=MAlloc(n+1,owner);MemCpy(copy,name,n+1);
+      created->str=copy;created->type=HTT_FILE;entry=created;
+    }
+  } catch {Free(data);Free(copy);Free(created);Fs->catch_except=FALSE;}
+  if(!created)Free(entry->user_data0);
+  entry->user_data0=data;entry->user_data1=bytes;
+  if(created)HashAdd(entry,owner->hash_table);
+}
+U8 *NativeResidentCopy(U8 *raw,I64 bytes,I64 attr,I64 *size)
+{
+  U8 *expanded=0,*result;I64 count=bytes;
+  if(attr&0x400) {
+    expanded=console_config->files->expand(console_config->heap,raw,bytes,&count);
+    if(!expanded)return 0;raw=expanded;
+  }
+  try {result=MAlloc(count+1);MemCpy(result,raw,count);result[count]=0;}
+  catch {if(expanded)I386HeapFree(console_config->heap,expanded);Fs->catch_except=FALSE;}
+  if(expanded)I386HeapFree(console_config->heap,expanded);
+  *size=count;return result;
+}
diff --git a/Kernel/I386/ResidentFiles.HC b/Kernel/I386/ResidentFiles.HC
new file mode 100644
index 00000000..52bd9cca
--- /dev/null
+++ b/Kernel/I386/ResidentFiles.HC
@@ -0,0 +1,48 @@
+//Mounted-service cache. Callers hold IF clear; entries own stored bytes.
+CI386ResidentFile *I386ResidentFind(CI386FileVolumes *volumes,U8 *name)
+{
+  CI386ResidentFile *entry=volumes->resident;
+  I64 i;
+  while(entry) {
+    i=0; while(name[i] && name[i]==entry->name[i]) i++;
+    if(name[i]==entry->name[i]) return entry;
+    entry=entry->next;
+  }
+  return 0;
+}
+Bool I386ResidentStore(CI386FileVolumes *volumes,CI386Heap *heap,U8 *name,U8 *data,I64 size,Bool resident)
+{
+  CI386ResidentFile *entry=0,*old,*previous=0,*cursor;
+  I64 length=0,i;
+  if(resident) {
+    heap=volumes->resident_heap; if(!heap) return FALSE;
+    while(name[length]) length++;
+    if(size<0 || size>0x7FFFFFFF-length-sizeof(CI386ResidentFile)-2) return FALSE;
+    entry=I386HeapAlloc(heap,sizeof(CI386ResidentFile)+length+size+2,TRUE);
+    if(!entry) return FALSE;
+    entry->heap=heap; entry->size=size; entry->name=(entry+1)(U8 *);
+    entry->data=entry->name+length+1;
+    for(i=0;i<=length;i++) entry->name[i]=name[i];
+    for(i=0;i<size;i++) entry->data[i]=data[i];
+  }
+  old=I386ResidentFind(volumes,name); cursor=volumes->resident;
+  while(cursor && cursor!=old) {previous=cursor;cursor=cursor->next;}
+  if(old) {
+    if(previous) previous->next=old->next; else volumes->resident=old->next;
+    I386HeapFree(old->heap,old);
+  }
+  if(entry) {entry->next=volumes->resident;volumes->resident=entry;}
+  return TRUE;
+}
+U8 *I386ResidentRead(CI386ResidentFile *entry,CI386Heap *heap,I64 *size,I64 *attr,Bool raw)
+{
+  U8 *result;
+  I64 i,bytes=entry->size,attributes=FileAttr(entry->name,0);
+  if(!raw && attributes&0x400) result=I386ExpandBuf(heap,entry->data,bytes,&bytes);
+  else {
+    result=I386HeapAlloc(heap,bytes+1,TRUE);
+    if(result) for(i=0;i<bytes;i++) result[i]=entry->data[i];
+  }
+  if(result) {if(size)*size=bytes;if(attr)*attr=attributes;}
+  return result;
+}
