//Shared opcode metadata. Explicit setup also supports targets without
//static string-pointer relocations. Initialize once before compiler use.
CIntermediateStruct intermediate_code_table[IC_ICS_NUM];
U0 ICInfoSet(I64 code,U8 args,U8 results,U8 type,Bool fpop,Bool not_const,U8 *name)
{
  CIntermediateStruct *entry=&intermediate_code_table[code];
  entry->arg_cnt=args; entry->res_cnt=results; entry->type=type;
  entry->fpop=fpop; entry->not_const=not_const; entry->name=name;
}
