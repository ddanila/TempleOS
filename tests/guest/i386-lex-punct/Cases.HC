U0 PunctSeed(CCmpCtrl *cc,CLexFile *file,U8 *input,I64 flags)
{
  U8 *bytes=cc; I64 i;
  for(i=0;i<sizeof(CCmpCtrl);i++) bytes[i]=0;
  bytes=file; for(i=0;i<sizeof(CLexFile);i++) bytes[i]=0;
  CmpCtrlSeed(cc,flags|CCF_DONT_FREE_BUF,0,char_bmp_alpha_numeric);
  LexFileSeed(file,input); cc->lex_include_stk=file; cc->cur_buf_ptr=input;
}
I64 PunctTest()
{
  CCmpCtrl cc; CLexFile file; I64 i,*r,lines,token; U8 *input;
  for(i=0;i<78;i++) {
    r=punct_rows+i*7; input=punct_inputs+r[0]; lines=0;
    PunctSeed(&cc,&file,input,r[6]); token=PunctToken(&cc,&lines);
    if(token!=r[1] || cc.token!=r[1] || cc.cur_buf_ptr!=input+r[2] ||
        cc.last_U16!=r[3] || ToBool(cc.flags&CCF_USE_LAST_U16)!=r[4] ||
        file.line_num!=r[5]+1) return 100+i;
  }
  return 0;
}
