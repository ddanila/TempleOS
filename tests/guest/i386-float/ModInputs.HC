U64 mod_special[16]={0,1,2,3,0x000FFFFFFFFFFFFF,0x0010000000000000,
  0x0010000000000001,0x3FD5555555555555,0x3FE0000000000000,
  0x3FF0000000000000,0x3FF8000000000000,0x4008000000000000,
  0x7FEFFFFFFFFFFFFF,0x7FF0000000000000,0x7FF0000000000001,0x7FF8000000001234};
U0 ModInputs(I64 i,U64 *seed,U64 *a,U64 *b)
{
  I64 j;
  *seed=*seed*6364136223846793005+1442695040888963407; *a=*seed;
  *seed=*seed*6364136223846793005+1442695040888963407; *b=*seed;
  if(i<1024) {
    *a=mod_special[i/32%16]; *b=mod_special[i%16];
    if(i/32>=16) *a|=0x8000000000000000;
    if(i%32>=16) *b|=0x8000000000000000;
  } else if(i<1536) {
    j=i-1024;
    *a=((1+j/8*32)(U64)<<52)|(*a&0x000FFFFFFFFFFFFF);
    *b=(j%4)*2+1;
    if(j&4) *a|=0x8000000000000000;
    if(j&2) *b|=0x8000000000000000;
  }
}
U64 HostModBits(U64 a,U64 b)
{
  F64 result=a(F64)%b(F64);
  return result(U64);
}
